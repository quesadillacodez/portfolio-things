# Optional public Google Analytics measurement ID. Leave empty to disable analytics.
# Never put private credentials in VITE_ variables: they are bundled into the browser.
VITE_GA_ID=

# Server-only contact form settings. Add these in Vercel, never as VITE_ variables.
RESEND_API_KEY=
# CONTACT_FROM must use a domain verified in Resend. The default is suitable for initial testing.
CONTACT_FROM=
# Optional: the inbox that receives inquiries. Defaults to hadiqbz@gmail.com.
CONTACT_TO=
